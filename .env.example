# Database PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=golang_db
DB_SSLMODE=disable

# Redis Configuration (Caching & Token Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Application Port
PORT=8080

# SMTP Email Configuration (Reset Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=585
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_SENDER_PASSWORD=your_app_password
# Frontend Web URL (Ganti ke domain produksi saat dideploy, misal: https://dashboard.domain-anda.com)
FRONTEND_URL=http://localhost:5173
